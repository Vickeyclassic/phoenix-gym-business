# Copy to .env.production on the deployment host; never commit the populated file.
# This file configures only deploy/production/compose.production.yml.
APP_DOMAIN=app.example.com
RELEASE_TAG=phoenix-v4-1
DB_NAME=phoenix_business
DB_USERNAME=phoenix_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Internal Docker hostname. Keep UTC transport/storage; business dates use Asia/Kolkata.
DB_URL=jdbc:mysql://mysql:3306/phoenix_business?serverTimezone=UTC&sslMode=REQUIRED
DB_POOL_SIZE=5
JWT_SECRET=
JWT_EXPIRATION_MS=900000
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=
CORS_ALLOWED_ORIGINS=https://app.example.com
# Browser resolves this through Caddy on the same HTTPS domain. Embedded at build time.
VITE_API_URL=/api
# Optional: replace tags with your approved immutable image digests.
MYSQL_IMAGE=mysql:8.4
CADDY_IMAGE=caddy:2-alpine
