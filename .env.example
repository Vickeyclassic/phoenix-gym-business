# Local Docker values only. Use secret storage in production.
DB_URL=jdbc:mysql://localhost:3306/phoenix_business?serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-local-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=900000
CORS_ALLOWED_ORIGINS=http://localhost:5173
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=ReplaceWith10PlusChars1
VITE_API_URL=http://localhost:8080/api
PORT=8080
DB_POOL_SIZE=10
