# Copy this file to .env for local Docker use. Never commit the resulting .env.
# Replace every CHANGE_ME value before running Docker Compose.

# Required local-only secrets.
DB_PASSWORD=CHANGE_ME_strong_local_database_password
JWT_SECRET=CHANGE_ME_random_string_at_least_32_characters
BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_StrongOwnerPassword1

# Safe local Docker defaults.
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080/api

# Optional overrides used when running services outside Docker Compose.
DB_URL=jdbc:mysql://localhost:3306/phoenix_business?serverTimezone=UTC
DB_USERNAME=root
JWT_EXPIRATION_MS=900000
BOOTSTRAP_OWNER_USERNAME=owner
PORT=8080
DB_POOL_SIZE=10
